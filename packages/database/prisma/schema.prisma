// ============================================
// SmartMailGuardian - Prisma Schema
// ============================================
// This is the Prisma schema file for the SmartMailGuardian database.
// Learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================
// User Model
// ===================
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  name            String?
  avatarUrl       String?   @map("avatar_url")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isActive        Boolean   @default(true) @map("is_active")
  role            UserRole  @default(USER)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  connectedMailboxes ConnectedMailbox[]
  securityEvents     SecurityEvent[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

// ===================
// Refresh Token Model
// ===================
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ===================
// Connected Mailbox Model
// ===================
model ConnectedMailbox {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  provider       EmailProvider
  email          String
  displayName    String?       @map("display_name")
  accessToken    String        @map("access_token") // Encrypted
  refreshToken   String?       @map("refresh_token") // Encrypted
  expiresAt      DateTime?     @map("expires_at")
  isActive       Boolean       @default(true) @map("is_active")
  lastSyncAt     DateTime?     @map("last_sync_at")
  syncCursor     String?       @map("sync_cursor") // For incremental sync
  settings       Json?         // Provider-specific settings
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@unique([userId, email])
  @@index([userId])
  @@index([provider])
  @@map("connected_mailboxes")
}

enum EmailProvider {
  GMAIL
  OUTLOOK
  YAHOO
  IMAP
}

// ===================
// Email Model
// ===================
model Email {
  id             String      @id @default(cuid())
  mailboxId      String      @map("mailbox_id")
  externalId     String      @map("external_id") // ID from provider
  threadId       String?     @map("thread_id")
  from           String
  fromName       String?     @map("from_name")
  to             String[]
  cc             String[]    @default([])
  bcc            String[]    @default([])
  subject        String
  bodyText       String?     @map("body_text")
  bodyHtml       String?     @map("body_html")
  snippet        String?     // Preview text
  receivedAt     DateTime    @map("received_at")
  isRead         Boolean     @default(false) @map("is_read")
  hasAttachments Boolean     @default(false) @map("has_attachments")
  headers        Json?       // Raw email headers
  labels         String[]    @default([])
  riskScore      Int?        @map("risk_score")
  riskLevel      RiskLevel?  @map("risk_level")
  status         EmailStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Relations
  mailbox     ConnectedMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  attachments EmailAttachment[]
  analysis    AIAnalysisResult?
  
  @@unique([mailboxId, externalId])
  @@index([mailboxId])
  @@index([receivedAt])
  @@index([riskLevel])
  @@index([status])
  @@map("emails")
}

enum RiskLevel {
  SAFE
  SUSPICIOUS
  DANGEROUS
}

enum EmailStatus {
  PENDING     // Not yet analyzed
  ANALYZING   // Currently being analyzed
  ANALYZED    // Analysis complete
  QUARANTINED // Moved to quarantine
  WHITELISTED // Marked as safe by user
}

// ===================
// Email Attachment Model
// ===================
model EmailAttachment {
  id        String  @id @default(cuid())
  emailId   String  @map("email_id")
  filename  String
  mimeType  String  @map("mime_type")
  size      Int
  contentId String? @map("content_id")
  
  // Analysis results
  isMalicious  Boolean @default(false) @map("is_malicious")
  isSuspicious Boolean @default(false) @map("is_suspicious")
  hasMacros    Boolean @default(false) @map("has_macros")
  scanResult   String? @map("scan_result")

  // Relations
  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@map("email_attachments")
}

// ===================
// AI Analysis Result Model
// ===================
model AIAnalysisResult {
  id                     String   @id @default(cuid())
  emailId                String   @unique @map("email_id")
  
  // Risk scores (0-100)
  riskScore              Int      @map("risk_score")
  phishingScore          Int      @map("phishing_score")
  malwareScore           Int      @map("malware_score")
  socialEngineeringScore Int      @map("social_engineering_score")
  spamScore              Int      @map("spam_score")
  
  // Analysis details
  riskLevel              RiskLevel @map("risk_level")
  reasons                Json      // Array of ThreatReason
  recommendations        String[]  @default([])
  explanation            String    // Human-readable explanation
  detectedPatterns       String[]  @default([]) @map("detected_patterns")
  
  // Sender analysis
  senderReputation       Json?     @map("sender_reputation")
  
  // URL & Attachment analysis
  urlAnalysis            Json?     @map("url_analysis")
  attachmentAnalysis     Json?     @map("attachment_analysis")
  
  // Metadata
  modelVersion           String    @map("model_version")
  processingTimeMs       Int?      @map("processing_time_ms")
  analyzedAt             DateTime  @default(now()) @map("analyzed_at")

  // Relations
  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([riskScore])
  @@index([riskLevel])
  @@index([analyzedAt])
  @@map("ai_analysis_results")
}

// ===================
// Security Event Model
// ===================
model SecurityEvent {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  emailId     String?            @map("email_id")
  eventType   SecurityEventType  @map("event_type")
  severity    EventSeverity
  title       String
  description String
  metadata    Json?
  isRead      Boolean            @default(false) @map("is_read")
  createdAt   DateTime           @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
  @@map("security_events")
}

enum SecurityEventType {
  THREAT_DETECTED
  EMAIL_QUARANTINED
  EMAIL_WHITELISTED
  MAILBOX_CONNECTED
  MAILBOX_DISCONNECTED
  SYNC_COMPLETED
  SYNC_FAILED
  USER_ACTION
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

// ===================
// Audit Log Model
// ===================
model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===================
// Domain Reputation Cache
// ===================
model DomainReputationCache {
  id          String   @id @default(cuid())
  domain      String   @unique
  trustScore  Int      @map("trust_score") // 0-100
  domainAge   Int?     @map("domain_age") // Days
  isSpammer   Boolean  @default(false) @map("is_spammer")
  spfRecord   Boolean? @map("spf_record")
  dkimRecord  Boolean? @map("dkim_record")
  dmarcRecord Boolean? @map("dmarc_record")
  lastChecked DateTime @default(now()) @map("last_checked")
  expiresAt   DateTime @map("expires_at")

  @@index([domain])
  @@index([expiresAt])
  @@map("domain_reputation_cache")
}

// ===================
// URL Reputation Cache
// ===================
model UrlReputationCache {
  id                 String   @id @default(cuid())
  url                String   @unique
  expandedUrl        String?  @map("expanded_url")
  domain             String
  isMalicious        Boolean  @default(false) @map("is_malicious")
  isSuspicious       Boolean  @default(false) @map("is_suspicious")
  isLoginPage        Boolean  @default(false) @map("is_login_page")
  sslValid           Boolean? @map("ssl_valid")
  brandImpersonation String?  @map("brand_impersonation")
  reputation         String   @default("unknown") // safe, suspicious, dangerous, unknown
  lastChecked        DateTime @default(now()) @map("last_checked")
  expiresAt          DateTime @map("expires_at")

  @@index([url])
  @@index([domain])
  @@index([expiresAt])
  @@map("url_reputation_cache")
}
