{
  "name": "smart-mail-guardian",
  "version": "1.0.0",
  "description": "AI-Powered Email Security Gateway - Protect your inbox from phishing, scams, malware & social engineering attacks",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @smart-mail-guardian/database db:generate",
    "db:push": "pnpm --filter @smart-mail-guardian/database db:push",
    "db:migrate": "pnpm --filter @smart-mail-guardian/database db:migrate",
    "db:studio": "pnpm --filter @smart-mail-guardian/database db:studio",
    "db:seed": "pnpm --filter @smart-mail-guardian/database db:seed",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.4",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "email-security",
    "phishing-detection",
    "ai",
    "machine-learning",
    "cybersecurity",
    "email-gateway",
    "nextjs",
    "nestjs",
    "fastapi"
  ],
  "author": "SmartMailGuardian Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/smart-mail-guardian.git"
  }
}
