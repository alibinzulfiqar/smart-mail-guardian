# ============================================
# SmartMailGuardian Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ===================
# Application
# ===================
NODE_ENV=development
APP_NAME=SmartMailGuardian
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_ENGINE_URL=http://localhost:8000

# ===================
# Database (PostgreSQL)
# ===================
DATABASE_URL="postgresql://postgres:password@localhost:5432/smartmailguardian?schema=public"

# ===================
# Redis
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================
# Authentication
# ===================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=30d

# ===================
# OAuth - Google (Gmail)
# ===================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ===================
# OAuth - Microsoft (Outlook)
# ===================
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/auth/microsoft/callback

# ===================
# Email Service
# ===================
EMAIL_SYNC_INTERVAL=60000
EMAIL_BATCH_SIZE=50

# ===================
# AI Engine
# ===================
AI_MODEL_PATH=./models
AI_CONFIDENCE_THRESHOLD=0.7
OPENAI_API_KEY=your-openai-api-key-optional

# ===================
# Encryption
# ===================
ENCRYPTION_KEY=your-32-character-encryption-key!

# ===================
# Rate Limiting
# ===================
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# ===================
# Logging
# ===================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ===================
# CORS
# ===================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
